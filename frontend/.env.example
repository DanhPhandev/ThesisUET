# Địa chỉ Spring Boot API Gateway, sử dụng bởi Next.js server khi proxy /api/v1
API_INTERNAL_URL=http://localhost:8080
# Optional: WebSocket endpoint for C++ clangd autocomplete / diagnostics / hover.
# Leave unset for automatic ws(s)://<browser-hostname>:6061/lsp.
# NEXT_PUBLIC_CLANGD_WS_URL=ws://localhost:6061/lsp

# Google Cloud OAuth 2.0 Web Client ID (Authorized JS origin http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
