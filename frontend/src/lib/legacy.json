{
  "courses": "\n\n<section class=\"banner\"><div class=\"container\"><h1>Khóa học</h1><p>Danh sách giao diện khóa học tĩnh, gồm bộ lọc, card khóa học và thông tin giảng viên.</p></div></section>\n<section class=\"section section-soft\"><div class=\"container\"><div class=\"toolbar\"><div class=\"search-box\"><input placeholder=\"Tìm khóa học...\"/><select><option>Tất cả cấp độ</option><option>Cơ bản</option><option>Nâng cao</option></select></div><a class=\"btn btn-primary\" href=\"/course-detail\">Xem chi tiết mẫu</a></div><div class=\"grid grid-3\">\n        <article class=\"card course-card\">\n          <a href=\"/course-detail\" class=\"course-thumb sql\"></a>\n          <div class=\"card-body\">\n            <div class=\"rating\">★★★★★ <span style=\"color:#64748b\">(120 Đánh Giá)</span></div>\n            <h3 class=\"card-title\"><a href=\"/course-detail\">Cơ Sở Dữ Liệu Và SQL</a></h3>\n            <div class=\"owner\"><span class=\"avatar-sm\">H</span><span>Đội Ngũ UET</span></div>\n            <div class=\"price\"><span class=\"price-new\">2,400,000đ</span><span class=\"price-old\">6,000,000đ</span></div>\n          </div>\n        </article>\n\n        <article class=\"card course-card\">\n          <a href=\"/course-detail\" class=\"course-thumb python\"></a>\n          <div class=\"card-body\">\n            <div class=\"rating\">★★★★★ <span style=\"color:#64748b\">(96 Đánh Giá)</span></div>\n            <h3 class=\"card-title\"><a href=\"/course-detail\">Lập trình Python cơ bản</a></h3>\n            <div class=\"owner\"><span class=\"avatar-sm\">H</span><span>Đội Ngũ UET</span></div>\n            <div class=\"price\"><span class=\"price-new\">2,900,000đ</span><span class=\"price-old\">6,000,000đ</span></div>\n          </div>\n        </article>\n\n        <article class=\"card course-card\">\n          <a href=\"/course-detail\" class=\"course-thumb web\"></a>\n          <div class=\"card-body\">\n            <div class=\"rating\">★★★★★ <span style=\"col